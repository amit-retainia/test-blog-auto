# Copy to .env and fill in. .env is gitignored — never commit real values.
# Cloudflare dashboard → R2 → Manage API tokens → Create (Object Read & Write)

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dobby-blog

# Public base URL for the bucket, no trailing slash.
# Demo: enable the r2.dev public URL on the bucket and paste it here.
# Production: use a custom domain instead — https://img.dobbyads.com
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxx.r2.dev
